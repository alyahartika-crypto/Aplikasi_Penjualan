<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="nota" pageWidth="300" pageHeight="500" columnWidth="260" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<parameter name="p_id_nota" class="java.lang.String"/>
	<title>
		<band height="150" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="10" width="260" height="30"/>
				<textElement textAlignment="Center"><font size="14" isBold="true"/></textElement>
				<text><![CDATA[=== TOKO SUKSES ===]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="50" width="260" height="20"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["NO NOTA: " + $P{p_id_nota}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="80" width="260" height="50"/>
				<textElement textAlignment="Center"><font size="11" isItalic="true"/></textElement>
				<text><![CDATA[BUKTI CETAK SUKSES!]]></text>
			</staticText>
		</band>
	</title>
</jasperReport>